# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mogent_ai?schema=public"

# Production Security Secrets (Mandatory for Production)
SESSION_SECRET="your-32-char-random-session-secret-key-here"
ENCRYPTION_SECRET="your-32-char-random-encryption-secret-key-here"
ENCRYPTION_SALT="mogent_salt_2026"

# Super Admin Gateway Credentials
SUPER_ADMIN_EMAIL="admin@mogent.ai"
SUPER_ADMIN_PASSWORD="change-this-to-a-strong-password-in-production"

# Redis Cache & Background Queue (Optional / Recommended for Multi-Instance)
REDIS_URL="redis://localhost:6379"

# AI Provider API Keys
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Meta Platform Credentials (Facebook Login for Business & WhatsApp Cloud API)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="mogent_ai_secure_verify_token_2026"

# Couriers API Credentials
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
